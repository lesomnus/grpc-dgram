{
  "name": "@lesomnus/grpc-dgram",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "gRPC over unreliable datagram channels — TypeScript port of gRPC-dgram (dRPC wire protocol v1.1)",
  "exports": {
    ".": "./dist/index.mjs",
    "./transport/webrtc": "./dist/transport/webrtc.mjs",
    "./transport/websocket": "./dist/transport/websocket.mjs",
    "./transport/port": "./dist/transport/port.mjs",
    "./transport/port/wasm": "./dist/transport/port/wasm.mjs",
    "./transport/node-udp": "./dist/transport/node-udp.mjs",
    "./transport/protobuf-es": "./dist/transport/protobuf-es.mjs",
    "./transport/connect": "./dist/transport/connect.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "gen": "buf generate ../proto --template buf.gen.yaml"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2",
    "@connectrpc/connect": "^2"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
