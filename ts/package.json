{
  "name": "@lesomnus/grpc-dgram",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "gRPC over unreliable datagram channels — TypeScript port of grpc-dgram (wire protocol v1.0)",
  "exports": {
    ".": "./dist/index.mjs",
    "./webrtc": "./dist/webrtc.mjs",
    "./protobuf-es": "./dist/protobufes.mjs",
    "./node-udp": "./dist/node-udp.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "gen": "buf generate ../proto --template buf.gen.yaml"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
