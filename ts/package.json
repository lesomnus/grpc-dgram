{
  "name": "@lesomnus/grpc-dgram",
  "type": "module",
  "version": "0.0.1",
  "description": "gRPC over unreliable datagram channels \u2014 TypeScript port of gRPC-dgram (dRPC wire protocol v1.1)",
  "license": "Apache-2.0",
  "author": "lesomnus",
  "homepage": "https://github.com/lesomnus/grpc-dgram/tree/main/ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lesomnus/grpc-dgram.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/lesomnus/grpc-dgram/issues"
  },
  "keywords": [
    "grpc",
    "drpc",
    "datagram",
    "webrtc",
    "websocket",
    "wasm",
    "connect"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs",
    "./transport/webrtc": "./dist/transport/webrtc.mjs",
    "./transport/websocket": "./dist/transport/websocket.mjs",
    "./transport/port": "./dist/transport/port.mjs",
    "./wasm": "./dist/wasm.mjs",
    "./wasm/worker": "./dist/wasm/worker.mjs",
    "./transport/node-udp": "./dist/transport/node-udp.mjs",
    "./transport/protobuf-es": "./dist/transport/protobuf-es.mjs",
    "./transport/connect": "./dist/transport/connect.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "gen": "buf generate ../proto --template buf.gen.yaml"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2",
    "@connectrpc/connect": "^2"
  },
  "peerDependenciesMeta": {
    "@bufbuild/protobuf": {
      "optional": true
    },
    "@connectrpc/connect": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@types/node": "^26.1.1",
    "tsdown": "^0.22.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
