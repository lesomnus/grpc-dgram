{
  // Type-checks the page against the TypeScript port's build output. The page
  // itself is plain JavaScript (`// @ts-check` + JSDoc), so there is nothing
  // to compile — this only reports mistakes:
  //
  //   cd ts && pnpm install && pnpm build
  //   cd ts && pnpm exec tsc -p ../examples/browser-webrtc
  //
  // The two `paths` entries stand in for the import map in index.html: the
  // package is unpublished, so both point at ts/dist.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@lesomnus/grpc-dgram": ["../../ts/dist/index.d.mts"],
      "@lesomnus/grpc-dgram/transport/webrtc": ["../../ts/dist/transport/webrtc.d.mts"]
    }
  },
  "include": ["web"]
}
